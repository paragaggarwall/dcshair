///newmodel here
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  userName  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  createdBy String?
  role      Role     @default(User)
}

model Customer {
  id               Int               @id @default(autoincrement())
  name             String
  email            String?           @unique
  address          String?
  phone            String?
  altPhone         String?
  city             String?
  state            String?
  country          String?
  pinCode          String?
  usciNo           String?
  contracts        Contract[]
  consignees       Consignee[]
  notifyParties    NotifyParty[]
  contactPersons   ContactPerson[]
  proformaInvoices ProformaInvoice[]
  invoices         Invoice[]
  createdBy        String?
  createdAt        DateTime          @default(now())
}

model Consignee {
  id               Int               @id @default(autoincrement())
  name             String
  email            String?
  address          String?
  phone            String?
  altPhone         String?
  city             String?
  state            String?
  country          String?
  usciNo           String?
  pinCode          String?
  createdAt        DateTime          @default(now())
  createdBy        String?
  customerId       Int
  customer         Customer          @relation(fields: [customerId], references: [id])
  contracts        Contract[]
  proformaInvoices ProformaInvoice[]
  invoices         Invoice[]
}

model NotifyParty {
  id               Int               @id @default(autoincrement())
  name             String
  email            String?
  address          String?
  phone            String?
  altPhone         String?
  city             String?
  state            String?
  country          String?
  pinCode          String?
  usciNo           String?
  createdAt        DateTime          @default(now())
  createdBy        String?
  customerId       Int
  customer         Customer          @relation(fields: [customerId], references: [id])
  contracts        Contract[]
  proformaInvoices ProformaInvoice[]
  invoices         Invoice[]
}

model ContactPerson {
  id               Int               @id @default(autoincrement())
  name             String
  email            String?
  address          String?
  phone            String?
  altPhone         String?
  city             String?
  state            String?
  country          String?
  pinCode          String?
  usciNo           String?
  createdAt        DateTime          @default(now())
  createdBy        String?
  customerId       Int
  customer         Customer          @relation(fields: [customerId], references: [id])
  contracts        Contract[]
  proformaInvoices ProformaInvoice[]
  invoices         Invoice[]
}

model Product {
  id                   Int                   @id @default(autoincrement())
  name                 String                @unique
  imageUrl             String?
  skuCode              String
  createdAt            DateTime              @default(now())
  createdBy            String?
  contractItems        ContractItem[]
  proformaInvoiceItems ProformaInvoiceItem[]
  invoiceItems         InvoiceItem[]
  // colors               Color[]
  // sizes                Size[]
}

model Color {
  id        Int      @id @default(autoincrement())
  color     String   @unique
  // productId Int?
  // product   Product? @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  createdBy String?
}

model Size {
  id        Int      @id @default(autoincrement())
  size      String   @unique
  // productId Int?
  // product   Product? @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  createdBy String?
}

model TermsOfPayment {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  contracts        Contract[]
  proformaInvoices ProformaInvoice[]
  invoices         Invoice[]
  createdBy        String?
  createdAt        DateTime          @default(now())
}

model Contract {
  id                          Int               @id @default(autoincrement())
  name                        String            @unique
  customerId                  Int
  customer                    Customer          @relation(fields: [customerId], references: [id])
  consigneeId                 Int?
  consignee                   Consignee?        @relation(fields: [consigneeId], references: [id])
  notifyPartyId               Int?
  notifyParty                 NotifyParty?      @relation(fields: [notifyPartyId], references: [id])
  contactPersonId             Int?
  contactPerson               ContactPerson?    @relation(fields: [contactPersonId], references: [id])
  termsOfPaymentId            Int
  termsOfPayment              TermsOfPayment    @relation(fields: [termsOfPaymentId], references: [id])
  invoicepaymentterm          invoicepayment?
  currency                    Currency?         @default(USD)
  preCarriageBy               Carrier?
  countryOfOrigin             String
  countryOfDestination        String
  portOfLoading               String?
  portOfFinalDestination      String?
  operatingAirlines           String?
  flightNo                    String?
  expectedDepartureDate       DateTime?
  expectedDepartureDateFormat String?
  expectedDeliveryDate        DateTime?
  expectedDeliveryDateFormat  String?
  shipingMark                 String?
  sizeScale                   String?
  packing                     String?
  specialCondition            String?
  otherRefrence               String?
  description                 String?
  insurance                   String?
  cartonweight                Float?
  contractItems               ContractItem[]
  proformaInvoices            ProformaInvoice[]
  invoices                    Invoice[]
  createdAt                   DateTime          @default(now())
  createdBy                   String?
}

model ContractItem {
  id         Int      @id @default(autoincrement())
  contractId Int
  contract   Contract @relation(fields: [contractId], references: [id])
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  color      String?
  size       String?
  weight     Float
  pricePerKg Float
  Amount     Float
}

enum Carrier {
  Sea
  Air
  Road
}

enum Role {
  Admin
  User
}

enum invoicepayment {
  CFR
  CIF
  CPT
}

enum Currency {
  USD
  INR
  EUR
}

model ProformaInvoice {
  id                        Int                   @id @default(autoincrement())
  customerId                Int
  customer                  Customer              @relation(fields: [customerId], references: [id])
  contractId                Int
  contract                  Contract              @relation(fields: [contractId], references: [id])
  proformaInvoiceNo         String                @unique
  proformaInvoiceDate       DateTime
  proformaInvoiceDateFormat String?
  currency                  Currency?             @default(USD)
  preCarriageBy             Carrier?
  operatingAirlines         String?
  flightNo                  String?
  lcNumber                  String?
  lcDate                    DateTime?
  lcDateFormat              String?
  otherRefrence             String?
  description               String?
  shipingMark               String?
  sizeScale                 String?
  packing                   String?
  countryOfOrigin           String
  countryOfDestination      String
  portOfLoading             String?
  portOfFinalDestination    String?
  cartonweight              Float?
  consigneeId               Int?
  consignee                 Consignee?            @relation(fields: [consigneeId], references: [id])
  notifyPartyId             Int?
  notifyParty               NotifyParty?          @relation(fields: [notifyPartyId], references: [id])
  contactPersonId           Int?
  contactPerson             ContactPerson?        @relation(fields: [contactPersonId], references: [id])
  termsOfPaymentId          Int
  termsOfPayment            TermsOfPayment        @relation(fields: [termsOfPaymentId], references: [id])
  invoicepaymentterm        invoicepayment?
  invoices                  Invoice[]
  items                     ProformaInvoiceItem[]
  createdAt                 DateTime              @default(now())
  createdBy                 String?
}

model ProformaInvoiceItem {
  id                Int             @id @default(autoincrement())
  proformaInvoiceId Int
  proformaInvoice   ProformaInvoice @relation(fields: [proformaInvoiceId], references: [id])
  productId         Int
  product           Product         @relation(fields: [productId], references: [id])
  color             String?
  size              String?
  weight            Float
  pricePerKg        Float
  Amount            Float
}

model Invoice {
  id                                        Int              @id @default(autoincrement())
  invoiceNo                                 String           @unique
  invoiceDate                               DateTime
  invoiceDateFormat                         String?
  customerId                                Int?
  customer                                  Customer?        @relation(fields: [customerId], references: [id])
  contractId                                Int?
  contract                                  Contract?        @relation(fields: [contractId], references: [id])
  proformaInvoiceId                         Int?
  proformaInvoice                           ProformaInvoice? @relation(fields: [proformaInvoiceId], references: [id])
  consigneeId                               Int?
  consignee                                 Consignee?       @relation(fields: [consigneeId], references: [id])
  notifyPartyId                             Int?
  notifyParty                               NotifyParty?     @relation(fields: [notifyPartyId], references: [id])
  contactPersonId                           Int?
  contactPerson                             ContactPerson?   @relation(fields: [contactPersonId], references: [id])
  termsOfPaymentId                          Int
  termsOfPayment                            TermsOfPayment   @relation(fields: [termsOfPaymentId], references: [id])
  invoicepaymentterm                        invoicepayment?
  preCarriageBy                             Carrier?
  currency                                  Currency?        @default(USD)
  operatingAirlines                         String?
  flightNo                                  String?
  countryOfOrigin                           String
  countryOfDestination                      String
  portOfLoading                             String?
  portOfFinalDestination                    String?
  lcNumber                                  String?
  lcDate                                    DateTime?
  lcDateFormat                              String?
  cartonweight                              Float?
  shipingMark                               String?
  sizeScale                                 String?
  packing                                   String?
  otherRefrence                             String?
  description                               String?
  cartonWeight                              Int?
  totalAmount                               Float            @default(0)
  shippingBillNo                            String?          @unique //shipment
  shippingDate                              DateTime?
  shippingDateFormat                        String?
  awbNo                                     String?          @unique
  awbNoDate                                 DateTime?
  awbNoDateFormat                           String?
  grossWeight                               Float?
  netWeight                                 Float?
  narration                                 String?
  cha                                       String?
  ebrcReceive                               Boolean?
  ebrcDate                                  DateTime?
  ebrcDateFormat                            String?
  ebrcNarration                             String?
  grRelease                                 Boolean?
  grDate                                    DateTime?
  grDateFormat                              String?
  grNarration                               String?
  epCopy                                    Boolean?
  epDate                                    DateTime?
  epDateFormat                              String?
  epNarration                               String?
  exporterCopy                              Boolean?
  exporterDate                              DateTime?
  exporterDateFormat                        String?
  exporterNarration                         String?
  factoryCode                               String?
  shipmentTakenBy                           String?
  shipmentHandedOverTo                      String?
  stockOutFromPKSGodown                     Boolean          @default(false)
  stockOutDateTime                          DateTime?
  stockOutDateTimeFormat                    String?
  passedShipmentFromCustom                  Boolean          @default(false)
  passedShipmentFromCustomDate              DateTime?
  passedShipmentFromCustomDateFormat        String?
  lorryNo                                   String?
  lorryInCustomWarehouse                    Boolean          @default(false)
  lorryInCustomWarehouseDateTime            DateTime?
  lorryInCustomWarehouseDateTimeFormat      String?
  lorryOutFromCustomWarehouse               Boolean          @default(false)
  lorryOutFromCustomWarehouseDateTime       DateTime?
  lorryOutFromCustomWarehouseDateTimeFormat String?
  containerNo                               String?
  containerStuffing                         Boolean          @default(false)
  containerStuffingDate                     DateTime?
  containerStuffingDateFormat               String?
  containerSealNo                           String?
  trainNo                                   String?
  trainOut                                  Boolean          @default(false)
  trainOutDateTime                          DateTime?
  trainOutDateTimeFormat                    String?
  dispatchDate                              DateTime? // Domestic shipment
  dispatchDateFormat                        String?
  courierCompany                            String?
  vehicleNo                                 String?
  driverName                                String?
  driverPhone                               String?
  // ewayBillNo                          String?          @unique
  // lrNo                                String?          @unique
  delivered                                 Boolean          @default(false)
  deliveredDate                             DateTime?
  deliveredDateFormat                       String?
  deliveryNarration                         String?
  items                                     InvoiceItem[]
  customSale                                CustomSale?
  bankSales                                 BankSale?
  billOfExchange                            BillOfExchange?
  createdAt                                 DateTime         @default(now())
  createdBy                                 String?
}

model InvoiceItem {
  id         Int     @id @default(autoincrement())
  invoiceId  Int
  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  productId  Int
  product    Product @relation(fields: [productId], references: [id])
  colour     String?
  size       String?
  weight     Float
  pricePerKg Float
  Amount     Float
}

model CustomSale {
  id                         Int       @id @default(autoincrement())
  invoiceId                  Int       @unique
  invoice                    Invoice   @relation(fields: [invoiceId], references: [id])
  customExchangeRate         Float
  cifCfrValue                Float?
  lessFreight                Float?
  lessInsurance              Float?
  lessCommission             Float?
  customFobValue             Float?
  drawBackPercentage         Float?
  drawBackValue              Float?
  drawBackDateReceived       DateTime?
  drawBackDateReceivedFormat String?
  drawBackNarration          String?
  focusPercentage            Float?
  focusValue                 Float?
  focusDateReceived          DateTime?
  focusDateReceivedFormat    String?
  createdAt                  DateTime  @default(now())
  createdBy                  String?
}

model BankSale {
  id                       Int       @id @default(autoincrement())
  invoiceId                Int       @unique
  invoice                  Invoice   @relation(fields: [invoiceId], references: [id])
  bankExchangeRate         Float?
  bankRefNo                String?   @unique
  bankRefDate              DateTime?
  bankRefDateFormat        String?
  negotiationAmount        Float?
  lessFreight              Float?
  lessInsurance            Float?
  lessCommissionIfAny      Float?
  bankFobValue             Float?
  dateOfRealisation        DateTime?
  dateOfRealisationFormat  String?
  realisationNarration     String?
  realisationdueDate       DateTime?
  realisationdueDateFormat String?
  courierCompany           String?
  trackingNo               String?
  createdAt                DateTime  @default(now())
  createdBy                String?
}

model BillOfExchange {
  id                  Int       @id @default(autoincrement())
  invoiceId           Int       @unique
  invoice             Invoice   @relation(fields: [invoiceId], references: [id])
  draftNo             String
  draftDate           DateTime
  draftDateFormat     String?
  exchangeAmount      Float
  currency            Currency? @default(USD)
  paymentTenor        String? // "Pay at sight", "30 days after sight"
  payToBank           String?
  payToBankAddress    String?
  payToBankSwiftCode  String?
  draweeName          String?
  draweeAddress       String?
  draweeUsciNo        String?
  acWithBank          String?
  acWithBankAddress   String?
  acWithBankSwiftCode String?
  createdAt           DateTime  @default(now())
  createdBy           String?
}
